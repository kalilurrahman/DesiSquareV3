# Copy to .env (git-ignored). Everything is OPTIONAL — defaults run the demo fully
# offline: deterministic metrics from the committed price fixture, no external accounts.

PORT=8791

# Market data: fixture (default — committed, deterministic, offline) | live (EOD feed).
# Live mode is a config-only switch; the feed must return the fixture's { dates, closes } shape.
PRICES_MODE=fixture
PRICES_FIXTURE=./test/fixtures/prices.json
PRICES_API_URL=
PRICES_API_KEY=

# Benchmark ticker for vs-benchmark metrics (must exist in the price data)
BENCHMARK=SPY

# Discourse that sends us post-created webhooks (signal_kind + ticker custom fields)
DISCOURSE_URL=http://host.docker.internal:8080

# Verify inbound webhooks (set the same secret in Discourse → Admin → API → Webhooks).
# Unset = signature check disabled (dev only, warned at startup).
# Must match the secret Discourse signs webhooks with (discourse/setup). Discourse
# rejects secrets shorter than 12 characters — keep them in sync.
DISCOURSE_WEBHOOK_SECRET=change-me-locally

# Daily batch on a timer: run the /jobs/reprice job every N minutes (0/unset = off;
# 1440 = daily). POST /jobs/reprice does the same on demand/cron.
REPRICE_INTERVAL_MINUTES=0
