# Copy to .env (git-ignored). Everything OPTIONAL — with no keys the bridge runs in MOCK mode
# (no real WhatsApp, no real Discourse posts) so you can develop the pipeline offline.

PORT=8788

# Discourse it posts into (inbound mirror). No key => posts are mocked (logged, not created).
DISCOURSE_URL=http://localhost:8080
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
# Category slug that mirrored messages post into
MIRROR_CATEGORY=ask-the-community
# Username used when the sender is not mapped to a member (phone is NEVER exposed)
GUEST_USERNAME=system

# Inbound WhatsApp backend. 'mock' (default) runs offline — inject with POST /simulate/message.
# 'whatsapp-web.js' uses the real UNOFFICIAL library (QR-paired WhatsApp Web session; the only way
# to READ group messages). ⚠ Violates WhatsApp ToS / risks a number ban — needs a business go/no-go
# and a DEDICATED number. Before setting this, run `npm run install:wa` (installs whatsapp-web.js +
# qrcode-terminal, pulls Chromium via puppeteer). On start, scan the QR from the console; the paired
# session is cached under data/wa-session (git-ignored).
WA_BACKEND=mock
WA_CLIENT_ID=desisquare

# Only these WhatsApp group JIDs are mirrored (comma-separated). Empty = allow all (dev only).
# Find a group's JID by sending a test message with WA_BACKEND=whatsapp-web.js and reading the logs.
ALLOWED_GROUPS=

# Outbound notifications via the OFFICIAL WhatsApp Cloud API. No token => notifications are mocked.
WA_CLOUD_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_NAME=desisquare_notification

# Verify inbound Discourse notification webhooks (set the same secret in Discourse)
DISCOURSE_WEBHOOK_SECRET=

# Secret used to hash phone numbers in logs (never log raw numbers)
PHONE_HASH_SALT=change-me
