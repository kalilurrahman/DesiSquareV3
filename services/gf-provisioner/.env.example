# Copy to .env (git-ignored). All OPTIONAL — with no keys the provisioner runs in MOCK mode
# (fake Ghostfolio account + summary) so you can develop offline.

PORT=8789

# Ghostfolio it provisions into. Set GHOSTFOLIO_LIVE=true to talk to a real self-hosted
# Ghostfolio (see services/ghostfolio/docker-compose.yml — `docker compose up -d`); leave it
# unset/false for MOCK mode (fake account + summary, no external calls). GHOSTFOLIO_ADMIN_TOKEN
# is optional (kept for future admin-scoped calls; anonymous user creation needs no token).
GHOSTFOLIO_URL=http://localhost:3333
GHOSTFOLIO_LIVE=false
GHOSTFOLIO_ADMIN_TOKEN=
# Language segment of Ghostfolio's OAuth-callback route used by SSO (/{lang}/auth/:jwt)
GHOSTFOLIO_LANG=en

# Verify inbound Discourse webhooks (user_created / user_confirmed_email)
DISCOURSE_WEBHOOK_SECRET=

# Public base URL of THIS provisioner — the single-click SSO login link points back at our own
# /sso/click endpoint so the security-token→JWT exchange stays server-side. Defaults to
# http://localhost:$PORT; set this if the provisioner is reachable at a different host/port.
PUBLIC_URL=

# Secret to sign single-click SSO login tokens (short-lived)
SSO_SECRET=change-me
SSO_TTL_SECONDS=120
