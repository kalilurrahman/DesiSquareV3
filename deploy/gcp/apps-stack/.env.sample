# ============================================================================
# DesiSquare apps stack — environment. Copy to .env; NEVER commit real values.
# 03-apps-vm-setup.sh auto-generates the random secrets on first run.
# ============================================================================

# --- Domain / TLS -----------------------------------------------------------
DOMAIN=desisquare.com
ACME_EMAIL=rahman.kalilur@outlook.com

# --- Ghostfolio -------------------------------------------------------------
POSTGRES_DB=ghostfolio
POSTGRES_USER=ghostfolio
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
ACCESS_TOKEN_SALT=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# See whatsapp/WHATSAPP-SETUP.md for where each value comes from.
META_GRAPH_API_VERSION=v21.0
WABA_ID=
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
PHONE_NUMBER_ID_COMMUNITY=
WEBHOOK_VERIFY_TOKEN=CHANGE_ME
WEBHOOK_PATH=/webhooks/whatsapp

# --- Bridge <-> Discourse ---------------------------------------------------
DISCOURSE_BASE_URL=https://community.desisquare.com
DISCOURSE_API_KEY=            # Admin -> API -> New Key (user: system, global)
DISCOURSE_API_USERNAME=system
DISCOURSE_WA_CATEGORY_ID=     # numeric id of the "WhatsApp Intake" category
DISCOURSE_WEBHOOK_SECRET=     # set the same value in Discourse Admin -> API -> Webhooks

# --- Bridge behavior --------------------------------------------------------
BRIDGE_API_KEY=CHANGE_ME      # protects POST /send
SERVICE_WINDOW_HOURS=24
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,CANCEL
DEFAULT_TEMPLATE_LANGUAGE=en
COMMUNITY_DISCLAIMER=Community discussion, not financial advice.
