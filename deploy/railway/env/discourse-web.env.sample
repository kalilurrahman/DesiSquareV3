# discourse-web service — image docker.io/bitnamilegacy/discourse:3.5.0-debian-12-r0
# (frozen tag — demo only; see deploy/railway/README.md)
# Railway ${{Service.VAR}} references assume services named Postgres / Redis.

DISCOURSE_HOST=your-discourse-subdomain.up.railway.app   # MUST equal the public domain
DISCOURSE_SITE_NAME=DesiSquare
DISCOURSE_USERNAME=desisquare_admin
DISCOURSE_PASSWORD=change-me-strong-password
DISCOURSE_EMAIL=admin@example.com

DISCOURSE_DATABASE_HOST=${{Postgres.PGHOST}}
DISCOURSE_DATABASE_PORT_NUMBER=5432
DISCOURSE_DATABASE_NAME=${{Postgres.PGDATABASE}}
DISCOURSE_DATABASE_USER=${{Postgres.PGUSER}}
DISCOURSE_DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}

DISCOURSE_REDIS_HOST=${{Redis.REDISHOST}}
DISCOURSE_REDIS_PORT_NUMBER=${{Redis.REDISPORT}}
DISCOURSE_REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

# Bitnami runs as UID 1001; Railway volumes need this to be writable:
RAILWAY_RUN_UID=0
# Volume mount path (web service only): /bitnami/discourse
# Target port: 3000 (DISCOURSE_PORT_NUMBER default)

# Uploads MUST offload to S3-compatible storage (web+sidekiq cannot share a volume):
#DISCOURSE_USE_S3=true
#DISCOURSE_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#DISCOURSE_S3_REGION=auto
#DISCOURSE_S3_ACCESS_KEY_ID=
#DISCOURSE_S3_SECRET_ACCESS_KEY=
#DISCOURSE_S3_UPLOAD_BUCKET=desisquare-uploads
#DISCOURSE_S3_BACKUP_BUCKET=desisquare-backups

# SMTP (Railway Pro plan only — egress blocked below Pro):
#DISCOURSE_SMTP_HOST=smtp-relay.brevo.com
#DISCOURSE_SMTP_PORT_NUMBER=587
#DISCOURSE_SMTP_PROTOCOL=tls
#DISCOURSE_SMTP_AUTH=login
#DISCOURSE_SMTP_USER=7xxxxx001@smtp-brevo.com
#DISCOURSE_SMTP_PASSWORD=xsmtpsib-...   # SMTP key, NOT an xkeysib- API key

# Seeding throughput (optional, revert after the community sim):
#DISCOURSE_MAX_ADMIN_API_REQS_PER_MINUTE=200
