# DesiSquare Phase-1 prototype — copy to .env (git-ignored). Every value is optional;
# with no .env at all the app runs fully standalone.

PORT=8786
PUBLIC_URL=http://localhost:8786

# POC services (Script 1 + Script 2). The app probes these and upgrades live when they answer.
WA_BRIDGE_URL=http://localhost:8788
GF_PROVISIONER_URL=http://localhost:8789
GHOSTFOLIO_URL=http://localhost:3333
DISCOURSE_URL=http://localhost:8080
MAILHOG_URL=http://localhost:8025

# Shared HMAC secret for Discourse-style webhooks (set the SAME value on wa-bridge + gf-provisioner).
DISCOURSE_WEBHOOK_SECRET=desisquare-dev-secret

# Discourse-compat surface (what wa-bridge posts into). Empty COMPAT_API_KEY = accept any
# non-empty Api-Key (local demo); set a value to pin it.
COMPAT_API_KEY=
GUEST_USERNAME=system

# Space (category) WhatsApp messages mirror into.
MIRROR_SPACE=help
