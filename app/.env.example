# Copy to .env (git-ignored). All OPTIONAL — without any of these the app runs fully in
# demo mode: every card degrades gracefully to the seeded prototype content.

PORT=5191

# Upstreams for the same-origin /api proxy (defaults = the local stack)
AI_URL=http://localhost:8787
WA_URL=http://localhost:8788
GF_URL=http://localhost:8789
MODELS_URL=http://localhost:8791
DISCOURSE_URL=http://localhost:8080

# Optional: injected server-side on /api/discourse writes (never sent to the browser)
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
